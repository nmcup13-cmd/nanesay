rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == 'employee';
    }

    match /leaveRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.status == 'รอพิจารณา'
        && request.resource.data.approverId == ''
        && request.resource.data.keys().hasAll(
          ['title','reason','status','requesterId','requesterName',
           'approverId','approverName','leaveTypeId','leaveTypeName',
           'startDate','endDate','createdAt']);

      allow update: if request.auth != null
        && resource.data.status == 'รอพิจารณา'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['อนุมัติ', 'ไม่อนุมัติ'];

      allow delete: if request.auth != null && resource.data.status == 'รอพิจารณา';
    }
  }
}
